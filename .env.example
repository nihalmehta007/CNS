# ── Crimson Nyx Studios — Environment Variables ─────────────────────
# Copy this file to .env and fill in your values.

# Application environment: "development" or "production"
APP_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=crimson_nyx
MONGO_POOL_SIZE=10
MONGO_TIMEOUT_MS=5000

# Admin credentials
# Generate a bcrypt hash:  python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_PASS_HASH=

# CORS allowed origins (comma-separated or JSON array)
# In development, localhost and 127.0.0.1 on all ports are allowed automatically.
# In production, specify your custom domain(s):
# CORS_ORIGINS=https://yourdomain.com,http://localhost:8000,http://localhost:8001

# Rate limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600

# Max request body size in bytes (default 1 MB)
MAX_BODY_SIZE=1048576

# Secret key for CSRF token signing (change in production!)
SECRET_KEY=change-me-in-production

# Mail (SMTP) — used to send contact-form notifications
# Generate a Gmail App Password:
#   1. Enable 2FA on your Google Account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=crimsonnyxstudios@gmail.com
MAIL_PASSWORD=
MAIL_RECIPIENT=crimsonnyxstudios@gmail.com
MAIL_ENABLED=true
