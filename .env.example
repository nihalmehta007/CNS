# ── Crimson Nyx Studios — Environment Variables ─────────────────────
# Copy this file to .env and fill in your values.

# Application environment: "development" or "production"
APP_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=crimson_nyx
MONGO_POOL_SIZE=10
MONGO_TIMEOUT_MS=5000

# Admin credentials
# Generate a bcrypt hash:  python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_PASS_HASH=

# CORS allowed origins (comma-separated in env, list in code)
# CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]

# Rate limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600

# Max request body size in bytes (default 1 MB)
MAX_BODY_SIZE=1048576
